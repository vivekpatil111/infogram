DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database, checked in this order:
#   1. DATABASE_URL  - one URL from a cloud provider (Neon, Supabase, Render, RDS)
#   2. POSTGRES_*    - separate settings for a local PostgreSQL
#   3. neither       - SQLite file db.sqlite3 (quick local experiments only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# POSTGRES_DB=infogram
# POSTGRES_USER=infogram
# POSTGRES_PASSWORD=infogram
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
# Media storage. Neon: `neon env pull -s object-storage` fills these four.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=infogram-media
MEDIA_PUBLIC_BASE_URL=
